<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Observabilidade Playground</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
      background: #f9f9f9;
    }
    h1, h2 {
      color: #333;
    }
    label {
      display: block;
      margin: 10px 0 5px;
    }
    input[type="number"], input[type="checkbox"] {
      margin-right: 10px;
    }
    button {
      margin-top: 15px;
      padding: 8px 15px;
      background: #007bff;
      color: white;
      border: none;
      cursor: pointer;
      border-radius: 4px;
    }
    button:hover {
      background: #0056b3;
    }
    canvas {
      margin-top: 20px;
      background: white;
      border: 1px solid #ccc;
      padding: 10px;
    }
  </style>
</head>
<body>
  <h1>🔧 Configurações de Teste</h1>
  <form method="POST" action="/update-features">
    <label>
      <input type="checkbox" name="simulateFailures" <% if (features.simulateFailures) { %>checked<% } %> />
      Simular falhas nas chamadas externas
    </label>

    <label>
      <input type="checkbox" name="stressMode" <% if (features.stressMode) { %>checked<% } %> />
      Estressar CPU e memória
    </label>

    <label>
      <input type="checkbox" name="simulateLatency" <% if (features.simulateLatency) { %>checked<% } %> />
      Simular lentidão na resposta
    </label>

    <label>
      Tempo de latência (ms):
      <input type="number" name="latencyDuration" value="<%= features.latencyDuration %>" />
    </label>

    <label>
      RPS (requests por segundo):
      <input type="number" name="rpsLimit" value="<%= features.rpsLimit %>" />
    </label>

    <label>
      % de chamadas que vão para API externa:
      <input type="number" name="externalCallPercentage" value="<%= features.externalCallPercentage %>" min="0" max="100" />
    </label>

    <button type="submit">Atualizar configurações</button>
  </form>

  <hr>

  <h2>📊 Monitoramento em tempo real</h2>
  <canvas id="chart" width="600" height="250"></canvas>

  <hr>

  <h2>🧪 Testes manuais</h2>
  <button onclick="testInternal()">Chamar /internal</button>
  <button onclick="forceError()">Simular erro 500</button>

  <script>
    const chart = new Chart(document.getElementById('chart'), {
      type: 'line',
      data: {
        labels: [],
        datasets: [{
          label: 'Tempo de resposta (ms)',
          data: [],
          borderWidth: 2,
          borderColor: 'blue',
          fill: false
        }]
      },
      options: {
        animation: false,
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });

    function updateChart(label, duration) {
      if (chart.data.labels.length > 20) {
        chart.data.labels.shift();
        chart.data.datasets[0].data.shift();
      }
      chart.data.labels.push(label);
      chart.data.datasets[0].data.push(duration);
      chart.update();
    }

    async function testInternal() {
      const start = performance.now();
      try {
        await fetch('/internal');
        const duration = performance.now() - start;
        updateChart(new Date().toLocaleTimeString(), duration);
      } catch (err) {
        updateChart(new Date().toLocaleTimeString(), 0);
        alert('Erro ao chamar /internal');
      }
    }

    async function forceError() {
      try {
        const res = await fetch('/force-error');
        const text = await res.text();
        alert(`Erro simulado: ${res.status} - ${text}`);
      } catch (err) {
        alert('Falha ao simular erro');
      }
    }

    setInterval(testInternal, 5000);
  </script>
</body>
</html>
